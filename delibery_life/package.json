{
  "name": "delivery-life",
  "version": "2.0.0",
  "private": true,
  "description": "DELIVERY LIFE — Cloudflare Pages + D1",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB --persist-to=.wrangler/state",
    "db:create": "wrangler d1 create delivery-life",
    "db:migrate:local": "wrangler d1 migrations apply delivery-life --local",
    "db:migrate:remote": "wrangler d1 migrations apply delivery-life --remote",
    "deploy": "wrangler pages deploy public --project-name=delivery-life"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
